#:import dp kivy.metrics.dp

<DvinesoulScreenManager>:
    SplashScreen:
        name: "splash"
    BrowserScreen:
        name: "browser"
    DownloadsScreen:
        name: "downloads"
    SettingsScreen:
        name: "settings"

<SplashScreen>:
    canvas.before:
        Color:
            rgba: 0.015, 0.025, 0.035, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.55, 1, 0.15, 0.04
        Ellipse:
            pos: self.center_x - dp(180), self.center_y - dp(180)
            size: dp(360), dp(360)

    BoxLayout:
        orientation: "vertical"
        padding: dp(30)
        spacing: dp(14)
        Widget:
        Label:
            text: "X-CORE"
            font_size: dp(40)
            bold: True
            color: 0.55, 1, 0.15, 1
            size_hint_y: None
            height: dp(58)
        Label:
            text: "DVINESOUL"
            font_size: dp(30)
            bold: True
            color: 1, 0.12, 0.18, 1
            size_hint_y: None
            height: dp(46)
        Label:
            text: "DOWNLOADER"
            font_size: dp(22)
            bold: True
            color: 0.9, 0.92, 0.95, 1
            size_hint_y: None
            height: dp(36)
        Widget:
        Label:
            text: "DVINESOUL DOWNLOADER"
            font_size: dp(24)
            bold: True
            color: 0.9, 0.92, 0.95, 1
            size_hint_y: None
            height: dp(40)
        Label:
            text: "Created by Neo Emmanuel"
            font_size: dp(14)
            color: 0.55, 0.6, 0.68, 1
            size_hint_y: None
            height: dp(28)
        Widget:
        Button:
            text: "START"
            size_hint_y: None
            height: dp(58)
            background_normal: ""
            background_color: 0.9, 0.08, 0.14, 1
            font_size: dp(18)
            bold: True
            on_release: app.start_app()
        Label:
            text: "X-CORE • DVINESOUL"
            font_size: dp(11)
            color: 0.35, 0.4, 0.48, 1
            size_hint_y: None
            height: dp(25)
        Widget:

<BrowserScreen>:
    canvas.before:
        Color:
            rgba: 0.015, 0.025, 0.035, 1
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: 0.55, 1, 0.15, 0.025
        Ellipse:
            pos: self.width - dp(180), self.height - dp(190)
            size: dp(320), dp(320)

    BoxLayout:
        orientation: "vertical"
        padding: dp(12)
        spacing: dp(8)

        BoxLayout:
            size_hint_y: None
            height: dp(52)
            Label:
                text: "X-CORE"
                font_size: dp(22)
                bold: True
                color: 0.55, 1, 0.15, 1
                halign: "left"
                text_size: self.size
            Label:
                text: "DVINESOUL DOWNLOADER"
                font_size: dp(13)
                color: 0.9, 0.92, 0.95, 1
                halign: "right"
                text_size: self.size

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(6)
            TextInput:
                id: search_input
                hint_text: "Search YouTube"
                multiline: False
                background_normal: ""
                background_color: 0.07, 0.09, 0.13, 1
                foreground_color: 0.92, 0.94, 0.98, 1
                cursor_color: 0.55, 1, 0.15, 1
                padding: dp(12), dp(10)
                on_text_validate: root.search_youtube()
            Button:
                text: "SEARCH"
                size_hint_x: None
                width: dp(95)
                background_normal: ""
                background_color: 0.55, 1, 0.15, 1
                color: 0.01, 0.02, 0.03, 1
                bold: True
                on_release: root.search_youtube()

        Label:
            id: search_status
            text: "Search YouTube videos inside Dvinesoul Downloader."
            size_hint_y: None
            height: dp(28)
            font_size: dp(11)
            color: 0.55, 0.6, 0.68, 1
            halign: "left"
            text_size: self.size

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                id: results_box
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(7)

        BoxLayout:
            id: download_panel
            orientation: "vertical"
            size_hint_y: None
            height: dp(170)
            padding: dp(8)
            spacing: dp(5)
            opacity: 0
            disabled: True
            canvas.before:
                Color:
                    rgba: 0.05, 0.07, 0.10, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10)]

            Label:
                id: selected_title
                text: "Select a video"
                font_size: dp(12)
                bold: True
                color: 0.65, 1, 0.05, 1
                halign: "left"
                text_size: self.size

            BoxLayout:
                size_hint_y: None
                height: dp(42)
                spacing: dp(6)
                ToggleButton:
                    id: format_mp4
                    text: "MP4"
                    group: "format"
                    background_normal: ""
                    background_color: 0.85, 0.05, 0.08, 1
                    on_release: root.choose_mp4()
                ToggleButton:
                    id: format_mp3
                    text: "MP3"
                    group: "format"
                    background_normal: ""
                    background_color: 0.85, 0.05, 0.08, 1
                    on_release: root.choose_mp3()
                Spinner:
                    id: quality
                    text: "Best available"
                    values: ["Best available"]
                    disabled: True

            Label:
                id: format_status
                text: "Choose a format."
                font_size: dp(10)
                color: 0.6, 0.65, 0.72, 1
                halign: "left"
                text_size: self.size

            BoxLayout:
                size_hint_y: None
                height: dp(40)
                spacing: dp(6)
                Label:
                    id: download_status
                    text: ""
                    font_size: dp(10)
                    color: 0.55, 1, 0.15, 1
                    halign: "left"
                    text_size: self.size
                Button:
                    id: download_button
                    text: "START DOWNLOAD"
                    size_hint_x: None
                    width: dp(145)
                    background_normal: ""
                    background_color: 0.9, 0.08, 0.14, 1
                    bold: True
                    on_release: root.start_download()

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(5)
            Button:
                text: "BROWSER"
                background_normal: ""
                background_color: 0.55, 1, 0.15, 1
                color: 0.01, 0.02, 0.03, 1
                bold: True
            Button:
                text: "DOWNLOADS"
                background_normal: ""
                background_color: 0.07, 0.09, 0.13, 1
                on_release: root.go("downloads")
            Button:
                text: "SETTINGS"
                background_normal: ""
                background_color: 0.07, 0.09, 0.13, 1
                on_release: root.go("settings")

<DownloadsScreen>:
    canvas.before:
        Color:
            rgba: 0.015, 0.025, 0.035, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(10)

        Label:
            text: "DVINESOUL DOWNLOADS"
            size_hint_y: None
            height: dp(50)
            font_size: dp(22)
            bold: True
            color: 0.55, 1, 0.15, 1

        Label:
            id: download_status
            text: "Ready."
            size_hint_y: None
            height: dp(30)
            font_size: dp(11)
            color: 0.65, 0.7, 0.78, 1
            halign: "left"
            text_size: self.size

        ScrollView:
            do_scroll_x: False
            Label:
                id: download_list
                text: "No downloads yet."
                size_hint_y: None
                height: max(self.texture_size[1], dp(180))
                text_size: self.width, None
                halign: "left"
                valign: "top"
                font_size: dp(13)
                color: 0.9, 0.92, 0.95, 1
                padding: dp(8), dp(8)

        Button:
            text: "REFRESH DOWNLOADS"
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.55, 1, 0.15, 1
            color: 0.01, 0.02, 0.03, 1
            bold: True
            on_release: root.refresh_downloads()

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(5)
            Button:
                text: "BROWSER"
                background_normal: ""
                background_color: 0.07, 0.09, 0.13, 1
                on_release: root.go("browser")
            Button:
                text: "DOWNLOADS"
                background_normal: ""
                background_color: 0.55, 1, 0.15, 1
                color: 0.01, 0.02, 0.03, 1
                bold: True
            Button:
                text: "SETTINGS"
                background_normal: ""
                background_color: 0.07, 0.09, 0.13, 1
                on_release: root.go("settings")

<SettingsScreen>:
    canvas.before:
        Color:
            rgba: 0.015, 0.025, 0.035, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(8)

        Label:
            text: "DVINESOUL SETTINGS"
            size_hint_y: None
            height: dp(52)
            font_size: dp(22)
            bold: True
            color: 0.55, 1, 0.15, 1

        ScrollView:
            do_scroll_x: False
            BoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(7)

                Label:
                    text: "APP\nDvinesoul Downloader\nVersion 0.2.0"
                    size_hint_y: None
                    height: dp(75)
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None
                    color: 0.9, 0.92, 0.95, 1

                Label:
                    text: "DOWNLOADS\nMP4 video • MP3 audio\nQuality options are read from the selected video."
                    size_hint_y: None
                    height: dp(88)
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None
                    color: 0.75, 0.8, 0.88, 1

                Label:
                    text: "ANDROID STORAGE\nDownloads use Android app-specific external storage. This follows scoped-storage rules and does not require broad storage access."
                    size_hint_y: None
                    height: dp(105)
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None
                    color: 0.75, 0.8, 0.88, 1

                Label:
                    text: "PERMISSIONS\nInternet access is required for YouTube search and downloads. The app does not request MANAGE_EXTERNAL_STORAGE."
                    size_hint_y: None
                    height: dp(88)
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None
                    color: 0.75, 0.8, 0.88, 1

                Label:
                    text: "COMPATIBILITY\nARM64-v8a + ARMv7 (armeabi-v7a)\nAndroid API 24+ / target API 33"
                    size_hint_y: None
                    height: dp(75)
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None
                    color: 0.75, 0.8, 0.88, 1

                Label:
                    text: "CREATOR\nNeo Emmanuel • X-CORE • DVINESOUL"
                    size_hint_y: None
                    height: dp(65)
                    halign: "left"
                    valign: "middle"
                    text_size: self.width, None
                    color: 0.55, 1, 0.15, 1

        BoxLayout:
            size_hint_y: None
            height: dp(48)
            spacing: dp(5)
            Button:
                text: "BROWSER"
                background_normal: ""
                background_color: 0.07, 0.09, 0.13, 1
                on_release: root.go("browser")
            Button:
                text: "DOWNLOADS"
                background_normal: ""
                background_color: 0.07, 0.09, 0.13, 1
                on_release: root.go("downloads")
            Button:
                text: "SETTINGS"
                background_normal: ""
                background_color: 0.55, 1, 0.15, 1
                color: 0.01, 0.02, 0.03, 1
                bold: True
